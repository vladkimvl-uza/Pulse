{
  "version": 1,
  "global": {
    "lang": "ru",
    "theme": "auto",
    "glass": "frosted",
    "tint": 0.64,
    "blur": 34,
    "radius": 26,
    "logos": true,
    "isp": true,
    "llm": true,
    "llmContainer": "auto",
    "netQuality": true,
    "psu": { "brand": null, "model": "", "watt": 850, "rating": "gold", "tariff": 0, "currency": "сум" },
    "fps": { "enabled": true, "hotkey": "Ctrl+Alt+F", "corner": "tl", "scope": "fullscreen", "content": "sensors", "zoom": 1, "opacity": 0.92 },
    "animations": "full",
    "tilt": true,
    "smoothCharts": true,
    "perf": "auto",
    "interval": 1000,
    "history": 120,
    "tempUnit": "C",
    "netUnit": "bytes",
    "gpu": "auto",
    "hotkey": "Ctrl+Alt+P",
    "hideFullscreen": true,
    "autostart": true,
    "snap": true,
    "snapGap": 14,
    "snapForce": 18,
    "snapWidgets": true,
    "linkWidgets": true,
    "trayMetric": "cpu",
    "alerts": { "enabled": true, "cpuTemp": 90, "gpuTemp": 85, "ramLoad": 95 },
    "anomaly": { "enabled": true, "notify": true, "sensitivity": "normal", "ignore": [], "detectors": { "hot": true, "fans": true, "idle": true, "leak": true, "rails": true, "net": true, "battery": true } },
    "colors": { "cpu": "#0A84FF", "gpu": "#30D158", "ram": "#BF5AF2", "disk": "#FF9F0A", "net": "#64D2FF", "llm": "#FF375F", "fans": "#63E6E2", "power": "#FFD60A", "battery": "#34C759" }
  },
  "widgetDefaults": {
    "w": 560,
    "h": 220,
    "x": null,
    "y": null,
    "mode": "desktop",
    "clickThrough": false,
    "ghost": true,
    "locked": false,
    "opacity": 1,
    "bgOpacity": 1,
    "zoom": 1,
    "modules": [
      { "id": "cpu", "on": true, "style": "auto" },
      { "id": "gpu", "on": true, "style": "auto" },
      { "id": "ram", "on": true, "style": "auto" },
      { "id": "disk", "on": false, "style": "auto" },
      { "id": "net", "on": false, "style": "auto" },
      { "id": "llm", "on": false, "style": "auto" },
      { "id": "fans", "on": false, "style": "auto" },
      { "id": "power", "on": false, "style": "auto" },
      { "id": "battery", "on": false, "style": "auto" }
    ]
  },
  "widgets": []
}
